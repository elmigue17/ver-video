# Llaves para transcribir el audio cuando el video no tiene subtítulos.
# Con una sola alcanza. Si pones las dos, se usa Groq.
#
# Este archivo es solo el ejemplo. La llave de verdad va en un archivo llamado .env
# en esta misma carpeta (~/.claude/skills/ver-video/.env). Ese archivo queda en tu
# computadora y no se sube a ningún lado.

# Groq: entra a https://console.groq.com/keys, toca "Create API Key" y copia la llave.
# Tiene un plan gratis con un tope de audio por hora.
GROQ_API_KEY=

# OpenRouter: entra a https://openrouter.ai/settings/keys, toca "Create" y copia la llave.
# Funciona con saldo prepago (se carga en https://openrouter.ai/settings/credits).
OPENROUTER_API_KEY=
